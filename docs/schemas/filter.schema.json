{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Filter Skill",
  "type": "object",
  "required": ["type", "column", "operator", "value"],
  "properties": {
    "type": { "const": "filter" },
    "column": { "type": "string" },
    "operator": { "type": "string", "enum": ["=","!=",">","<",">=","<=","contains"] },
    "value": { }
  },
  "additionalProperties": false
}
